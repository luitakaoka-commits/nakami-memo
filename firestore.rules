rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // 許可するサブコレクション名のホワイトリスト。
    // 以前は match /{document=**} でサブコレクション名を一切制限していなかった。
    // tools / recipes / consumptions は今後の追加予定分。
    function allowedCollection(name) {
      return name in ["areas", "locations", "items", "tools", "recipes", "consumptions"];
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // 直下のドキュメント（users/{userId}/{collection}/{docId}）
      match /{collection}/{docId} {
        allow read, write: if isOwner(userId) && allowedCollection(collection);

        // さらに下の階層はコレクション名を限定せず、所有者のみに許可する。
        match /{document=**} {
          allow read, write: if isOwner(userId) && allowedCollection(collection);
        }
      }
    }

    // 公開閲覧専用。ここには公開画面で見せる最小情報だけを複製する。
    match /publicLocations/{publicToken} {
      allow get: if resource.data.isPublic == true;
      allow list: if false;
      allow create: if signedIn() && request.auth.uid == request.resource.data.ownerId;
      allow update: if signedIn() && request.auth.uid == resource.data.ownerId && request.auth.uid == request.resource.data.ownerId;
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerId;
    }
  }
}

