# Firebase の接続先は環境変数ではなく src/lib/firebase/config.ts に書いてある（3アプリ共通の cash-manege）。
# 公開してよい値で、環境変数にすると Vercel に残っている古い nakami-memo の値に黙ってつながるため。

# Supabase Storage（画像アップロード / バケット: nakami-memo-images）
# アップロードAPI（src/app/api/images/upload/route.ts）が実行時に使う。
# next/image の許可ホストは next.config.ts に直書きしてあるので、ビルド時には不要。
SUPABASE_URL=https://<プロジェクトRef>.supabase.co
SUPABASE_SECRET_KEY=

# レシピ提案（Phase 3）で使う。サーバー側だけで読む。NEXT_PUBLIC_ を付けないこと。
GEMINI_API_KEY=
